generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
  Клиент использует строки с дефисом ('16-20', '21-25', ...) —
  Prisma-enum так не может, идентификаторы не начинаются с цифры
  и не содержат дефис. Значения здесь маппятся туда-обратно
  в src/lib/ageGroup.ts, чтобы JSON API отдавал ровно тот формат,
  который уже ожидает клиент (types/fitness.ts не меняется).

  Границы не пересекаются (16-20, 21-25, 26-30, ...) — раньше
  соседние диапазоны делили одно и то же граничное значение
  (20 попадал и в "16-20", и в "20-25"), и было не очевидно,
  какую группу выбирать при регистрации.
*/
enum AgeGroup {
  AGE_16_20
  AGE_21_25
  AGE_26_30
  AGE_31_35
  AGE_36_40
  AGE_41_PLUS
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
}

// Минимальный уровень подготовки, с которого упражнение уместно
// (используется конструктором тренировок для фильтрации каталога)
enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

// USER (по умолчанию) -> ADMIN -> CREATOR. Ровно один CREATOR — назначается
// data-миграцией по email (см. migration.sql), защищён на уровне БД partial
// unique индексом (User_singleton_creator) и на уровне приложения — target
// с ролью CREATOR отклоняется первой же проверкой в каждом хендлере
// Сервер/src/routes/admin.ts, независимо от роли того, кто запрашивает
enum Role {
  USER
  ADMIN
  CREATOR
}

enum MessagingPrivacy {
  EVERYONE
  FRIENDS_ONLY
  NOBODY
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

// PENDING — заявка на вступление в PRIVATE-группу, ждёт решения владельца/модератора
enum GroupMemberStatus {
  PENDING
  MEMBER
}

enum ReportCategory {
  HARASSMENT
  SPAM
  SCAM
  INAPPROPRIATE_PROFILE
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum NotificationType {
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  GROUP_JOIN_REQUEST
  GROUP_JOIN_APPROVED
  GROUP_POST_COMMENT
  GROUP_POST_LIKE
  REPORT_RESOLVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  avatar       String?
  bio          String?
  location     String?
  timezone     String?  // IANA-идентификатор (Europe/Moscow) — используется часами в шапке
  ageGroup     AgeGroup @default(AGE_26_30)
  createdAt    DateTime @default(now())

  // Не заполняются при регистрации — донастраиваются в Настройках профиля
  githubUsername    String?
  steamId           String?
  // Личный Steam Web API ключ — только для синхронизации достижений по
  // всей библиотеке (см. SteamGameAchievements). Публичный VITE_STEAM_API_KEY
  // с фронтенда для этого не годится: понадобились бы сотни запросов прямо
  // из браузера при каждой загрузке страницы. Клиенту обратно не отдаётся —
  // serializeUser отдаёт только hasSteamApiKey (см. lib/serializeUser.ts)
  steamApiKey       String?
  backgroundType    String  @default("preset")
  backgroundUrl     String  @default("")
  backgroundBlur    Int     @default(0)
  backgroundOpacity Float   @default(0.85)

  // Выбранные вручную любимые игры Steam (appId), до 7, порядок = порядок выбора
  favoriteSteamAppIds Int[] @default([])

  // Название вкладки «своя библиотека» в списке упражнений — если не задано,
  // клиент показывает дефолтное «Моя библиотека»
  exerciseLibraryName String?

  // Порядок панелей по вкладкам (General/Dev/Fitness/Games), настроенный
  // перетаскиванием за ручку в шапке панели — null, если пользователь
  // ничего не перетаскивал (тогда клиент берёт порядок по умолчанию из
  // PANEL_REGISTRY). Json, а не плоские колонки — набор id переменной
  // длины на вкладку, как achievements в SteamGameAchievements
  panelLayout Json?

  // Вкладка, которая открывается по умолчанию при входе. Новым аккаунтам
  // при регистрации ставится 'general' явно (см. routes/auth.ts); null —
  // для существующих аккаунтов, которые никогда это не настраивали
  // (тогда клиент падает на прежнее поведение — Dev)
  defaultSection String?

  // Кто может написать первым, если ещё не в друзьях. Друзей это не
  // ограничивает — им можно писать всегда, независимо от значения здесь
  // (см. lib/messaging.ts). Только UI-подсказка на клиенте не опирается —
  // сервер перепроверяет на каждой отправке сообщения/заявки
  messagingPrivacy MessagingPrivacy @default(EVERYONE)

  role Role @default(USER)

  // Бан: bannedAt = null -> не забанен. bannedUntil = null при заданном
  // bannedAt -> бан постоянный, иначе сравнивается с now() лениво при
  // каждой проверке (см. lib/ban.ts) — отдельного крона на снятие
  // просроченного бана нет, поле просто перестаёт считаться активным
  bannedAt       DateTime?
  bannedUntil    DateTime?
  banReason      String?
  bannedByUserId String?
  bannedBy       User?      @relation("BannedBy", fields: [bannedByUserId], references: [id], onDelete: SetNull)
  bannedUsers    User[]     @relation("BannedBy")

  measurements      BodyMeasurement[]
  inbodyResults     InBodyResult[]
  workouts          Workout[]
  customExercises   Exercise[]              @relation("ExerciseCreator")
  steamAchievements SteamGameAchievements[]
  auditActions      AdminAuditLog[]         @relation("AuditActor")

  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
  blocksMade          Block[]      @relation("BlockBlocker")
  blocksAgainst       Block[]      @relation("BlockBlocked")

  conversationParticipations ConversationParticipant[]
  sentMessages               Message[]

  ownedGroups      Group[]            @relation("GroupOwner")
  groupMemberships GroupMember[]
  groupPosts       GroupPost[]        @relation("GroupPostAuthor")
  groupComments    GroupPostComment[] @relation("GroupCommentAuthor")
  groupPostLikes   GroupPostLike[]

  reportsFiled    Report[] @relation("ReportReporter")
  reportsAgainst  Report[] @relation("ReportReported")
  reportsResolved Report[] @relation("ReportResolver")

  notifications Notification[]
}

// Журнал действий администраторов — только на запись, эндпоинта на
// изменение/удаление записей нет и не будет. actorUsername/targetUsername —
// снэпшот на момент действия, чтобы запись оставалась читаемой, даже если
// аккаунт-актёр или аккаунт-цель потом переименован/удалён. actorId — с FK
// (onDelete: SetNull), обнуляется автоматически при удалении актёра.
// targetId — БЕЗ FK намеренно: цель действия к моменту записи лога иногда
// уже удалена (см. DELETE_USER в routes/admin.ts — лог пишется ПОСЛЕ
// успешного удаления, чтобы не логировать неудавшиеся попытки), FK на
// несуществующую строку не дал бы такую запись вставить
model AdminAuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorUsername  String
  targetId       String?
  targetUsername String?
  // BAN | UNBAN | DELETE_USER | RESET_PASSWORD | PROMOTE_ADMIN | DEMOTE_ADMIN
  action  String
  // { days, reason } для BAN; { previousRole, newRole } для PROMOTE/DEMOTE и т.п.
  details Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BodyMeasurement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime
  weightKg Float
  chestCm  Float
  waistCm  Float
  hipsCm   Float
  bicepCm  Float
  thighCm  Float
  notes    String?

  // Опциональные — не все замеры делаются с анализатором состава тела
  bodyFatPercent       Float?
  skeletalMuscleMassKg Float?

  @@index([userId])
}

model InBodyResult {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   DateTime
  weightKg               Float
  bodyFatPercent         Float
  skeletalMuscleMassKg   Float
  muscleMassKg           Float
  bodyWaterPercent       Float
  bmi                    Float
  visceralFatLevel       Int
  basalMetabolicRateKcal Int

  @@index([userId])
}

// Общий каталог упражнений: системные (createdByUserId = null, никто не может
// менять/удалять) + пользовательские (своя библиотека создателя, видны всем
// в «Сообществе», но редактировать/удалять может только создатель). Для
// конструктора тренировок (workoutGenerator.ts) и ручного добавления
// подходов используются вообще все строки разом, вне зависимости от автора.
model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  equipment   String?
  description String?

  // Теги для конструктора тренировок (WorkoutBuilder):
  // homeFriendly — выполнимо дома одним весом тела (без зального оборудования)
  // compound     — базовое многосуставное упражнение (присед/тяга/жим и т.п.)
  // minLevel     — с какого уровня подготовки упражнение уместно
  homeFriendly Boolean         @default(false)
  compound     Boolean         @default(false)
  minLevel     ExperienceLevel @default(beginner)

  // bodyweightOnly — вес не вводится руками, используется вес тела из замеров
  // isTimeBased    — WorkoutSet.reps на самом деле хранит минуты, а не повторы
  //                  (планка, бег, велотренажёр и т.п.)
  bodyweightOnly Boolean @default(false)
  isTimeBased    Boolean @default(false)

  // null — системное упражнение из сида, иначе — автор из своей библиотеки
  createdByUserId String?
  createdBy       User?   @relation("ExerciseCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  sets WorkoutSet[]

  @@index([createdByUserId])
}

model Workout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  durationMin Int
  notes       String?
  // Момент сохранения записи — отдельно от date (дата, за которую засчитана
  // тренировка, выбирается вручную в форме и у нескольких тренировок за один
  // день совпадает вплоть до полуночи UTC). История сортируется по date, а
  // при совпадении — по createdAt, чтобы только что добавленная тренировка
  // всегда оказывалась выше остальных за тот же день.
  createdAt   DateTime @default(now())

  sets WorkoutSet[]

  @@index([userId])
}

// Кэш достижений по одной игре одного пользователя — наполняется вручную
// через POST /steam-achievements/sync, а не на каждый запрос: полная
// синхронизация всей библиотеки — это сотни обращений к Steam Web API,
// делать их при каждой загрузке страницы нельзя (см. routes/steamAchievements.ts)
model SteamGameAchievements {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId         Int
  gameName      String
  // AchievementDetail[] — apiname/displayName/description/icon/unlocked/
  // unlockTime/globalPercent, форма описана в devprofile/src/types/steam.ts
  achievements  Json
  achievedCount Int
  totalCount    Int
  syncedAt      DateTime @default(now())

  @@unique([userId, appId])
  @@index([userId])
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  weightKg   Float

  @@index([workoutId])
}

// Блокировка — глушит сообщения и заявки в друзья в обе стороны (см.
// lib/blocklist.ts, lib/messaging.ts), скрывает профили друг у друга из
// поиска. Разблокировка — просто DELETE строки, отдельного статуса нет
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Одна строка на пару людей, направление — requester/addressee. При
// отклонении или отмене заявки строка удаляется целиком (история заявок в
// друзья не хранится — не то же самое, что AdminAuditLog, там своя причина
// хранить всё). Взаимная заявка (B->A, пока A->B ещё PENDING) — обрабатывается
// в routes/friends.ts как мгновенный ACCEPTED существующей строки, а не
// вторая строка
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  // Единственное сообщение, которое не-друг может отправить получателю с
  // messagingPrivacy = FRIENDS_ONLY — прикладывается прямо к заявке, а не
  // отправляется как обычное сообщение в переписке (см. lib/messaging.ts)
  requestMessage String?
  createdAt      DateTime         @default(now())
  respondedAt    DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// Личные и групповые переписки — одна модель. Групповая (type=GROUP) —
// groupId заполнен, участники синхронизированы с GroupMember. Личная
// (type=DIRECT) — создаётся по требованию, directKey не даёт создать вторую
// переписку между теми же двумя людьми
model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  groupId   String?          @unique
  group     Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Только для DIRECT: "меньшийId:большийId" — находит единственную переписку
  // между двумя людьми без сканирования участников на каждый старт чата
  directKey String?          @unique
  createdAt DateTime         @default(now())
  // Денормализовано с Message.createdAt последнего сообщения — сортировка
  // списка переписок по последней активности без агрегирующего запроса
  // (Prisma не умеет orderBy по _max связанного поля, только по _count)
  lastMessageAt DateTime     @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Для счётчика непрочитанного — сообщения после этой отметки и есть
  // непрочитанные, отдельной таблицы "прочитано на сообщение" не заводим
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  // Снэпшот на случай удаления автора — тот же приём, что actorUsername/
  // targetUsername в AdminAuditLog
  senderUsername String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Group {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  avatar      String?
  privacy     GroupPrivacy @default(PUBLIC)
  ownerId     String
  // Restrict, не Cascade — удаление владельца не должно молча снести группу.
  // Даёт P2003 при DELETE /admin/users/:id, перехватывается тем же паттерном,
  // что уже есть там для Exercise (см. routes/admin.ts)
  owner       User         @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  members      GroupMember[]
  conversation Conversation?
  posts        GroupPost[]

  @@index([ownerId])
}

model GroupMember {
  id       String            @id @default(cuid())
  groupId  String
  group    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole   @default(MEMBER)
  status   GroupMemberStatus @default(MEMBER)
  joinedAt DateTime          @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, status])
}

model GroupPost {
  id             String   @id @default(cuid())
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?    @relation("GroupPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorUsername String
  body           String
  createdAt      DateTime @default(now())

  comments GroupPostComment[]
  likes    GroupPostLike[]

  @@index([groupId, createdAt])
}

model GroupPostComment {
  id             String    @id @default(cuid())
  postId         String
  post           GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?     @relation("GroupCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorUsername String
  body           String
  createdAt      DateTime  @default(now())

  @@index([postId, createdAt])
}

model GroupPostLike {
  id        String    @id @default(cuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// Тот же приём, что AdminAuditLog: nullable FK (onDelete SetNull) + username-
// снэпшот у репортёра, цели и администратора-резолвера — запись остаётся
// читаемой, даже если чей-то аккаунт потом удалили. Решение одновременно
// пишется и сюда (видно автору жалобы через GET /reports/mine), и в
// AdminAuditLog через существующий logAdminAction (видно Создателю в общем
// журнале) — см. routes/admin.ts
model Report {
  id               String         @id @default(cuid())
  reporterId       String?
  reporter         User?          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterUsername String
  reportedId       String?
  reported         User?          @relation("ReportReported", fields: [reportedId], references: [id], onDelete: SetNull)
  reportedUsername String
  category         ReportCategory
  description      String

  status ReportStatus @default(PENDING)

  resolvedByUserId   String?
  resolvedBy         User?     @relation("ReportResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedByUsername String?
  // NO_ACTION | WARNING | BAN_TEMPORARY | BAN_PERMANENT | OTHER
  resolutionAction String?
  resolutionNote   String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([reportedId])
}

// Только для точечных событий (заявки, вступление в группу, жалоба решена,
// активность на стене) — новое сообщение в чате НЕ создаёт запись здесь,
// непрочитанное там уже считается через ConversationParticipant.lastReadAt
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  // id заявки/группы/поста и т.п. — чтобы клик по уведомлению вёл сразу куда нужно
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
