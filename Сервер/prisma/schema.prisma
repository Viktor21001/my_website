generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
  Клиент использует строки с дефисом ('16-20', '21-25', ...) —
  Prisma-enum так не может, идентификаторы не начинаются с цифры
  и не содержат дефис. Значения здесь маппятся туда-обратно
  в src/lib/ageGroup.ts, чтобы JSON API отдавал ровно тот формат,
  который уже ожидает клиент (types/fitness.ts не меняется).

  Границы не пересекаются (16-20, 21-25, 26-30, ...) — раньше
  соседние диапазоны делили одно и то же граничное значение
  (20 попадал и в "16-20", и в "20-25"), и было не очевидно,
  какую группу выбирать при регистрации.
*/
enum AgeGroup {
  AGE_16_20
  AGE_21_25
  AGE_26_30
  AGE_31_35
  AGE_36_40
  AGE_41_PLUS
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
}

// Минимальный уровень подготовки, с которого упражнение уместно
// (используется конструктором тренировок для фильтрации каталога)
enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  avatar       String?
  bio          String?
  location     String?
  timezone     String?  // IANA-идентификатор (Europe/Moscow) — используется часами в шапке
  ageGroup     AgeGroup @default(AGE_26_30)
  createdAt    DateTime @default(now())

  // Не заполняются при регистрации — донастраиваются в Настройках профиля
  githubUsername    String?
  steamId           String?
  // Личный Steam Web API ключ — только для синхронизации достижений по
  // всей библиотеке (см. SteamGameAchievements). Публичный VITE_STEAM_API_KEY
  // с фронтенда для этого не годится: понадобились бы сотни запросов прямо
  // из браузера при каждой загрузке страницы. Клиенту обратно не отдаётся —
  // serializeUser отдаёт только hasSteamApiKey (см. lib/serializeUser.ts)
  steamApiKey       String?
  backgroundType    String  @default("preset")
  backgroundUrl     String  @default("")
  backgroundBlur    Int     @default(0)
  backgroundOpacity Float   @default(0.85)

  // Выбранные вручную любимые игры Steam (appId), до 7, порядок = порядок выбора
  favoriteSteamAppIds Int[] @default([])

  // Название вкладки «своя библиотека» в списке упражнений — если не задано,
  // клиент показывает дефолтное «Моя библиотека»
  exerciseLibraryName String?

  // Порядок панелей по вкладкам (General/Dev/Fitness/Games), настроенный
  // перетаскиванием за ручку в шапке панели — null, если пользователь
  // ничего не перетаскивал (тогда клиент берёт порядок по умолчанию из
  // PANEL_REGISTRY). Json, а не плоские колонки — набор id переменной
  // длины на вкладку, как achievements в SteamGameAchievements
  panelLayout Json?

  // Вкладка, которая открывается по умолчанию при входе. Новым аккаунтам
  // при регистрации ставится 'general' явно (см. routes/auth.ts); null —
  // для существующих аккаунтов, которые никогда это не настраивали
  // (тогда клиент падает на прежнее поведение — Dev)
  defaultSection String?

  measurements      BodyMeasurement[]
  inbodyResults     InBodyResult[]
  workouts          Workout[]
  customExercises   Exercise[]              @relation("ExerciseCreator")
  steamAchievements SteamGameAchievements[]
}

model BodyMeasurement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime
  weightKg Float
  chestCm  Float
  waistCm  Float
  hipsCm   Float
  bicepCm  Float
  thighCm  Float
  notes    String?

  // Опциональные — не все замеры делаются с анализатором состава тела
  bodyFatPercent       Float?
  skeletalMuscleMassKg Float?

  @@index([userId])
}

model InBodyResult {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   DateTime
  weightKg               Float
  bodyFatPercent         Float
  skeletalMuscleMassKg   Float
  muscleMassKg           Float
  bodyWaterPercent       Float
  bmi                    Float
  visceralFatLevel       Int
  basalMetabolicRateKcal Int

  @@index([userId])
}

// Общий каталог упражнений: системные (createdByUserId = null, никто не может
// менять/удалять) + пользовательские (своя библиотека создателя, видны всем
// в «Сообществе», но редактировать/удалять может только создатель). Для
// конструктора тренировок (workoutGenerator.ts) и ручного добавления
// подходов используются вообще все строки разом, вне зависимости от автора.
model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  equipment   String?
  description String?

  // Теги для конструктора тренировок (WorkoutBuilder):
  // homeFriendly — выполнимо дома одним весом тела (без зального оборудования)
  // compound     — базовое многосуставное упражнение (присед/тяга/жим и т.п.)
  // minLevel     — с какого уровня подготовки упражнение уместно
  homeFriendly Boolean         @default(false)
  compound     Boolean         @default(false)
  minLevel     ExperienceLevel @default(beginner)

  // bodyweightOnly — вес не вводится руками, используется вес тела из замеров
  // isTimeBased    — WorkoutSet.reps на самом деле хранит минуты, а не повторы
  //                  (планка, бег, велотренажёр и т.п.)
  bodyweightOnly Boolean @default(false)
  isTimeBased    Boolean @default(false)

  // null — системное упражнение из сида, иначе — автор из своей библиотеки
  createdByUserId String?
  createdBy       User?   @relation("ExerciseCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  sets WorkoutSet[]

  @@index([createdByUserId])
}

model Workout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  durationMin Int
  notes       String?
  // Момент сохранения записи — отдельно от date (дата, за которую засчитана
  // тренировка, выбирается вручную в форме и у нескольких тренировок за один
  // день совпадает вплоть до полуночи UTC). История сортируется по date, а
  // при совпадении — по createdAt, чтобы только что добавленная тренировка
  // всегда оказывалась выше остальных за тот же день.
  createdAt   DateTime @default(now())

  sets WorkoutSet[]

  @@index([userId])
}

// Кэш достижений по одной игре одного пользователя — наполняется вручную
// через POST /steam-achievements/sync, а не на каждый запрос: полная
// синхронизация всей библиотеки — это сотни обращений к Steam Web API,
// делать их при каждой загрузке страницы нельзя (см. routes/steamAchievements.ts)
model SteamGameAchievements {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId         Int
  gameName      String
  // AchievementDetail[] — apiname/displayName/description/icon/unlocked/
  // unlockTime/globalPercent, форма описана в devprofile/src/types/steam.ts
  achievements  Json
  achievedCount Int
  totalCount    Int
  syncedAt      DateTime @default(now())

  @@unique([userId, appId])
  @@index([userId])
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  weightKg   Float

  @@index([workoutId])
}
