generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/*
  Клиент использует строки с дефисом ('16-20', '21-25', ...) —
  Prisma-enum так не может, идентификаторы не начинаются с цифры
  и не содержат дефис. Значения здесь маппятся туда-обратно
  в src/lib/ageGroup.ts, чтобы JSON API отдавал ровно тот формат,
  который уже ожидает клиент (types/fitness.ts не меняется).

  Границы не пересекаются (16-20, 21-25, 26-30, ...) — раньше
  соседние диапазоны делили одно и то же граничное значение
  (20 попадал и в "16-20", и в "20-25"), и было не очевидно,
  какую группу выбирать при регистрации.
*/
enum AgeGroup {
  AGE_16_20
  AGE_21_25
  AGE_26_30
  AGE_31_35
  AGE_36_40
  AGE_41_PLUS
}

enum MuscleGroup {
  chest
  back
  legs
  shoulders
  arms
  core
  cardio
}

// Минимальный уровень подготовки, с которого упражнение уместно
// (используется конструктором тренировок для фильтрации каталога)
enum ExperienceLevel {
  beginner
  intermediate
  advanced
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  avatar       String?
  bio          String?
  location     String?
  ageGroup     AgeGroup @default(AGE_26_30)
  createdAt    DateTime @default(now())

  // Не заполняются при регистрации — донастраиваются в Настройках профиля
  githubUsername    String?
  steamId           String?
  backgroundType    String  @default("preset")
  backgroundUrl     String  @default("")
  backgroundBlur    Int     @default(0)
  backgroundOpacity Float   @default(0.85)

  // Выбранные вручную любимые игры Steam (appId), до 7, порядок = порядок выбора
  favoriteSteamAppIds Int[] @default([])

  measurements  BodyMeasurement[]
  inbodyResults InBodyResult[]
  workouts      Workout[]
}

model BodyMeasurement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime
  weightKg Float
  chestCm  Float
  waistCm  Float
  hipsCm   Float
  bicepCm  Float
  thighCm  Float
  notes    String?

  @@index([userId])
}

model InBodyResult {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   DateTime
  weightKg               Float
  bodyFatPercent         Float
  skeletalMuscleMassKg   Float
  muscleMassKg           Float
  bodyWaterPercent       Float
  bmi                    Float
  visceralFatLevel       Int
  basalMetabolicRateKcal Int

  @@index([userId])
}

// Общий каталог упражнений — один на всех, не привязан к User
model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  equipment   String?
  description String?

  // Теги для конструктора тренировок (WorkoutBuilder):
  // homeFriendly — выполнимо дома одним весом тела (без зального оборудования)
  // compound     — базовое многосуставное упражнение (присед/тяга/жим и т.п.)
  // minLevel     — с какого уровня подготовки упражнение уместно
  homeFriendly Boolean         @default(false)
  compound     Boolean         @default(false)
  minLevel     ExperienceLevel @default(beginner)

  // bodyweightOnly — вес не вводится руками, используется вес тела из замеров
  // isTimeBased    — WorkoutSet.reps на самом деле хранит минуты, а не повторы
  //                  (планка, бег, велотренажёр и т.п.)
  bodyweightOnly Boolean @default(false)
  isTimeBased    Boolean @default(false)

  sets WorkoutSet[]
}

model Workout {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  title       String
  durationMin Int
  notes       String?

  sets WorkoutSet[]

  @@index([userId])
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setNumber  Int
  reps       Int
  weightKg   Float

  @@index([workoutId])
}
